# supabase/config.toml env() 치환용. 복사: cp supabase/.env.example supabase/.env (gitignore됨)
# 카카오 개발자 콘솔 REST API 키 / Client Secret. Redirect URI에 http://localhost:54321/auth/v1/callback 등록 필요.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
# 웹 푸시(Edge Function send-push가 사용). 생성: npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://dongchat-eta.vercel.app
# DB 웹훅 비밀. 로컬 seed.sql의 Vault 값과 같아야 한다.
PUSH_WEBHOOK_SECRET=local-dev-push-secret
# 로컬 검증(가짜 푸시 서버)용: http·임의 호스트 endpoint 허용. 운영에서는 절대 설정하지 않는다(SSRF 방지 해제).
PUSH_ALLOW_HTTP=true
