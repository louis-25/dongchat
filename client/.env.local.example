# client/.env.local 템플릿 — 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요.
#   cp client/.env.local.example client/.env.local
# 시크릿은 git에 올리지 말고 수동/비밀번호 매니저로 동기화하세요.

# 백엔드 주소 (클라이언트에서 사용 → NEXT_PUBLIC_ 유지)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- 서버 전용 시크릿 (NEXT_PUBLIC_ 금지! 브라우저로 유출됨) ---
# server 의 NEXTAUTH_SECRET 과 반드시 동일한 값
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Kakao OAuth (카카오 개발자 콘솔에서 발급) — auth.ts(서버)에서만 사용
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 클라이언트에서 필요한 공개값 (NEXT_PUBLIC_ 유지) ---
# server VAPID_PUBLIC_KEY 와 동일한 공개키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
