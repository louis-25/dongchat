# client/.env.local 템플릿 — 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요.
#   cp client/.env.local.example client/.env.local
# 시크릿은 git에 올리지 말고 수동/비밀번호 매니저로 동기화하세요.

# 백엔드 주소
NEXT_PUBLIC_API_URL=http://localhost:4000

# server 의 NEXTAUTH_SECRET 과 동일한 값
NEXT_PUBLIC_NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Kakao OAuth (카카오 개발자 콘솔에서 발급)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_SECRET=

# server VAPID_PUBLIC_KEY 와 동일한 공개키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
