# server/.env 템플릿 — 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp server/.env.example server/.env
# 시크릿(NEXTAUTH_SECRET, VAPID_*)은 git에 올리지 말고 비밀번호 매니저/수동 복사로 머신 간 동기화하세요.

# --- DB (docker-compose.yml 기본값과 일치) ---
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=dongchat
DB_PASSWORD=dongchat
DB_DATABASE=dongchat

# --- 인증 ---
# 클라이언트 NEXT_PUBLIC_NEXTAUTH_SECRET 과 반드시 동일한 값이어야 JWT 검증이 통과됩니다.
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- CORS (쉼표로 여러 개 허용) ---
FRONTEND_URL=http://localhost:3000

# --- Web Push (VAPID) ---
# 키 생성:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
